<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kleio.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kleio"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Advanced_Header" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">

                <!-- ===== Pause ===== -->
                <TextBlock x:Uid="Advanced_PauseSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" Margin="1,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="Advanced_PauseCard" Glyph="&#xE769;">
                    <ToggleSwitch x:Name="PauseToggle" x:Uid="Advanced_PauseToggle" Toggled="PauseToggle_Toggled" />
                </local:SettingsCard>
                <Border Style="{StaticResource SettingsCardBorderStyle}" MinHeight="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" Style="{StaticResource SettingsCardIconStyle}" VerticalAlignment="Top" Margin="2,2,4,0" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Uid="Advanced_ScriptsIntro" Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14" />
                            <TextBlock x:Uid="Advanced_PauseScript" Style="{StaticResource SettingsMonospaceTextStyle}" />
                            <TextBlock x:Uid="Advanced_IgnoreNextIntro" Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14" />
                            <TextBlock x:Uid="Advanced_IgnoreNextScript" Style="{StaticResource SettingsMonospaceTextStyle}" />
                            <TextBlock x:Uid="Advanced_TrayIconHint" Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Clearing ===== -->
                <TextBlock x:Uid="Advanced_ClearingSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="Advanced_ClearOnQuitCard" Glyph="&#xE74D;">
                    <ToggleSwitch x:Name="ClearOnQuitToggle" x:Uid="Advanced_ClearOnQuitToggle" Toggled="ClearOnQuitToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Advanced_ClearSystemClipboardCard" Glyph="&#xE77F;">
                    <ToggleSwitch x:Name="ClearSystemClipboardToggle" x:Uid="Advanced_ClearSystemClipboardToggle" Toggled="ClearSystemClipboardToggle_Toggled" />
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
