<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kleio.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kleio"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Advanced" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">

                <!-- ===== Pause ===== -->
                <TextBlock Text="Pause" Style="{StaticResource SettingsSectionHeaderTextStyle}" Margin="1,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard Header="Pause Kleio" Glyph="&#xE769;"
                                    Description="Temporarily ignore all new copies. Useful to keep Kleio from recording while you copy sensitive data.">
                    <ToggleSwitch x:Name="PauseToggle" AutomationProperties.Name="Pause Kleio" Toggled="PauseToggle_Toggled" />
                </local:SettingsCard>
                <Border Style="{StaticResource SettingsCardBorderStyle}" MinHeight="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" Style="{StaticResource SettingsCardIconStyle}" VerticalAlignment="Top" Margin="2,2,4,0" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14">You are likely to use this from scripts. Pause Kleio from the command line while copying sensitive data:</TextBlock>
                            <TextBlock Style="{StaticResource SettingsMonospaceTextStyle}" AutomationProperties.Name="kleio.exe --pause, copy data, then kleio.exe --resume">kleio.exe --pause<LineBreak />&#x2026; copy data &#x2026;<LineBreak />kleio.exe --resume</TextBlock>
                            <TextBlock Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14">To ignore only the next copy:</TextBlock>
                            <TextBlock Style="{StaticResource SettingsMonospaceTextStyle}" AutomationProperties.Name="kleio.exe --ignore-next, then copy data">kleio.exe --ignore-next<LineBreak />&#x2026; copy data &#x2026;</TextBlock>
                            <TextBlock Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14">You can also Alt+click the tray icon to pause or resume Kleio. To ignore only the next copy, Alt+Shift+click it.</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Clearing ===== -->
                <TextBlock Text="Clearing" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard Header="Clear history on quit" Glyph="&#xE74D;"
                                    Description="Automatically remove all unpinned items before quitting Kleio.">
                    <ToggleSwitch x:Name="ClearOnQuitToggle" AutomationProperties.Name="Clear history on quit" Toggled="ClearOnQuitToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard Header="Clear the system clipboard too" Glyph="&#xE77F;"
                                    Description="When enabled, clearing the history also clears the current Windows clipboard.">
                    <ToggleSwitch x:Name="ClearSystemClipboardToggle" AutomationProperties.Name="Clear the system clipboard too" Toggled="ClearSystemClipboardToggle_Toggled" />
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
