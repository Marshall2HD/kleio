<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kleio.ShortcutRecorder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Unloaded="Recorder_Unloaded">
    <StackPanel
        x:Name="RootPanel"
        Orientation="Horizontal"
        Spacing="4"
        VerticalAlignment="Center"
        PreviewKeyDown="Root_PreviewKeyDown"
        PreviewKeyUp="Root_PreviewKeyUp">
        <Button
            x:Name="EditButton"
            MinHeight="36"
            Padding="6,4,10,4"
            Background="Transparent"
            BorderThickness="1"
            Click="EditButton_Click"
            LostFocus="EditButton_LostFocus"
            ToolTipService.ToolTip="Select to record a new shortcut. Esc cancels, Backspace clears.">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel x:Name="KeysPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Not set" />
                <FontIcon
                    x:Name="EditGlyph"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="&#xE70F;"
                    AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
        </Button>
        <Button
            x:Name="ClearButton"
            Width="36"
            Height="36"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Click="ClearButton_Click"
            AutomationProperties.Name="Clear shortcut"
            ToolTipService.ToolTip="Clear shortcut">
            <FontIcon FontSize="12" Glyph="&#xE711;" />
        </Button>
    </StackPanel>
</UserControl>
