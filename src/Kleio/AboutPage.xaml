<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kleio.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kleio"
    Background="Transparent"
    Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="About_Header" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Padding="24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="96"
                            Height="96"
                            VerticalAlignment="Top"
                            Source="ms-appx:///Assets/Square150x150Logo.png"
                            x:Uid="About_Logo" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Kleio" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="About_Description" Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,0" />
                            <Button
                                x:Name="CheckUpdatesButton"
                                x:Uid="About_CheckUpdatesButton"
                                Margin="0,12,0,0"
                                Click="CheckUpdatesButton_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <InfoBar x:Name="UpdateInfoBar" IsClosable="True" />

                <TextBlock x:Uid="About_CreditsSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="About_MaccyCard" Glyph="&#xE734;">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton x:Uid="About_MaccyWebsite" NavigateUri="https://maccy.app" />
                        <HyperlinkButton x:Uid="About_MaccyGitHub" NavigateUri="https://github.com/p0deje/Maccy" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="About_SourceCard" Glyph="&#xE943;">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton x:Uid="About_KleioGitHub" NavigateUri="https://github.com/Marshall2HD/kleio" />
                        <HyperlinkButton x:Uid="About_Support" NavigateUri="https://github.com/Marshall2HD/kleio/issues" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="About_LicenseCard" Glyph="&#xE8A5;">
                    <HyperlinkButton x:Uid="About_MitLicenseLink" NavigateUri="https://github.com/Marshall2HD/kleio/blob/HEAD/LICENSE" />
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
