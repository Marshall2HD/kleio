<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kleio.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kleio"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="General_Header" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">

                <!-- ===== Startup and updates ===== -->
                <local:SettingsCard x:Uid="General_LaunchAtLoginCard" Glyph="&#xE7E8;">
                    <ToggleSwitch x:Name="LaunchAtLoginToggle" x:Uid="General_LaunchAtLoginToggle" Toggled="LaunchAtLoginToggle_Toggled" />
                </local:SettingsCard>
                <InfoBar
                    x:Name="LaunchAtLoginInfoBar"
                    x:Uid="General_LaunchAtLoginInfoBar"
                    Severity="Warning"
                    IsClosable="True" />

                <local:SettingsCard x:Uid="General_CheckForUpdatesCard" Glyph="&#xE895;">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button x:Name="CheckNowButton" x:Uid="General_CheckNow" Click="CheckNowButton_Click" />
                        <ToggleSwitch x:Name="CheckForUpdatesToggle" x:Uid="General_CheckForUpdatesToggle" Toggled="CheckForUpdatesToggle_Toggled" />
                    </StackPanel>
                </local:SettingsCard>
                <InfoBar x:Name="UpdateInfoBar" IsClosable="True" />

                <local:SettingsCard x:Uid="General_LanguageCard" Glyph="&#xF2B7;">
                    <ComboBox x:Name="LanguageCombo" x:Uid="General_LanguageCombo" MinWidth="220" SelectionChanged="LanguageCombo_SelectionChanged" />
                </local:SettingsCard>
                <InfoBar x:Name="LanguageInfoBar" x:Uid="General_LanguageInfoBar" Severity="Informational" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Uid="General_LanguageRestart" Click="LanguageRestart_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ===== Shortcuts ===== -->
                <TextBlock x:Uid="General_ShortcutsSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="General_OpenCard" Glyph="&#xE765;">
                    <local:SettingsCard.Description>
                        <TextBlock x:Uid="General_OpenDescription" TextWrapping="Wrap" />
                    </local:SettingsCard.Description>
                    <local:ShortcutRecorder x:Name="PopupRecorder" x:Uid="General_PopupRecorder" />
                </local:SettingsCard>
                <InfoBar
                    x:Name="HotKeyInfoBar"
                    x:Uid="General_HotKeyInfoBar"
                    Severity="Error"
                    IsClosable="True" />
                <local:SettingsCard x:Uid="General_PinCard" Glyph="&#xE718;">
                    <local:ShortcutRecorder x:Name="PinRecorder" x:Uid="General_PinRecorder" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="General_DeleteCard" Glyph="&#xE74D;">
                    <local:ShortcutRecorder x:Name="DeleteRecorder" x:Uid="General_DeleteRecorder" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="General_PreviewCard" Glyph="&#xE8FF;">
                    <local:ShortcutRecorder x:Name="PreviewRecorder" x:Uid="General_PreviewRecorder" />
                </local:SettingsCard>

                <!-- ===== Search ===== -->
                <TextBlock x:Uid="General_SearchSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="General_SearchModeCard" Glyph="&#xE721;">
                    <ComboBox x:Name="SearchModeCombo" x:Uid="General_SearchModeCombo" SelectionChanged="SearchModeCombo_SelectionChanged">
                        <ComboBoxItem x:Uid="General_SearchExact" />
                        <ComboBoxItem x:Uid="General_SearchFuzzy" />
                        <ComboBoxItem x:Uid="General_SearchRegex" />
                        <ComboBoxItem x:Uid="General_SearchMixed" />
                    </ComboBox>
                </local:SettingsCard>

                <!-- ===== Behavior ===== -->
                <TextBlock x:Uid="General_BehaviorSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="General_PasteAutomaticallyCard" Glyph="&#xE77F;">
                    <ToggleSwitch x:Name="PasteAutomaticallyToggle" x:Uid="General_PasteAutomaticallyToggle" Toggled="PasteAutomaticallyToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="General_RemoveFormattingCard" Glyph="&#xE8D2;">
                    <ToggleSwitch x:Name="RemoveFormattingToggle" x:Uid="General_RemoveFormattingToggle" Toggled="RemoveFormattingToggle_Toggled" />
                </local:SettingsCard>
                <Border Style="{StaticResource SettingsCardBorderStyle}" MinHeight="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIconStyle}" VerticalAlignment="Top" Margin="2,2,4,0" />
                        <TextBlock x:Name="ModifiersDescription" Grid.Column="1" Style="{StaticResource SettingsDescriptionTextStyle}" FontSize="14" IsTextSelectionEnabled="True" />
                    </Grid>
                </Border>

                <!-- ===== Windows clipboard ===== -->
                <TextBlock x:Uid="General_WindowsClipboardSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Uid="General_WindowsClipboardIntro" Style="{StaticResource SettingsParagraphTextStyle}" />
                <local:SettingsCard x:Uid="General_ReplaceWinVCard" Glyph="&#xE8C8;">
                    <ToggleSwitch x:Name="ReplaceWinVToggle" x:Uid="General_ReplaceWinVToggle" Toggled="ReplaceWinVToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="General_BlockWinCCard" Glyph="&#xE8F8;">
                    <ToggleSwitch x:Name="BlockWinCToggle" x:Uid="General_BlockWinCToggle" Toggled="BlockWinCToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="General_ClipboardSettingsCard" Glyph="&#xE81C;">
                    <HyperlinkButton x:Name="ClipboardSettingsLink" x:Uid="General_ClipboardSettingsLink" Click="ClipboardSettingsLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="General_ClipboardSettingsOpen" />
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                </local:SettingsCard>

                <!-- ===== Notifications and sounds ===== -->
                <TextBlock x:Uid="General_NotificationsSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="General_ShowNotificationsCard" Glyph="&#xEA8F;">
                    <ToggleSwitch x:Name="ShowNotificationsToggle" x:Uid="General_ShowNotificationsToggle" Toggled="ShowNotificationsToggle_Toggled" />
                </local:SettingsCard>
                <InfoBar
                    x:Name="NotificationsInfoBar"
                    x:Uid="General_NotificationsInfoBar"
                    Severity="Warning"
                    IsClosable="False" />
                <local:SettingsCard x:Uid="General_PlaySoundsCard" Glyph="&#xE767;">
                    <ToggleSwitch x:Name="PlaySoundsToggle" x:Uid="General_PlaySoundsToggle" Toggled="PlaySoundsToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="General_NotificationSettingsCard" Glyph="&#xE713;">
                    <HyperlinkButton x:Name="NotificationSettingsLink" x:Uid="General_NotificationSettingsLink" Click="NotificationSettingsLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="General_NotificationSettingsOpen" />
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
