<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kleio.HistoryItemRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    IsTabStop="False">

    <!-- UI Automation: the row is a single element (Maccy ListItemView .accessibilityElement(children: .ignore));
         HistoryItemRow::ApplyAutomation names it, so the visual parts below are Raw. -->
    <Grid x:Name="RowRoot" Height="30" Margin="4,1,4,1" CornerRadius="4" Background="Transparent">
        <ToolTipService.ToolTip>
            <ToolTip x:Name="RowToolTip" />
        </ToolTipService.ToolTip>

        <!-- Windows list selection look: subtle fill + accent pill. -->
        <Border x:Name="SelectionFill"
                CornerRadius="4"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Opacity="0" />
        <Rectangle x:Name="SelectionPill"
                   Width="3"
                   Height="16"
                   RadiusX="1.5"
                   RadiusY="1.5"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                   Visibility="Collapsed" />

        <Grid Padding="12,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppIconImage"
                   AutomationProperties.AccessibilityView="Raw"
                   Grid.Column="0"
                   Width="16"
                   Height="16"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />

            <Border x:Name="ColorSwatch"
                    Grid.Column="1"
                    Width="14"
                    Height="14"
                    Margin="0,0,8,0"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

            <TextBlock x:Name="TitleText"
                   AutomationProperties.AccessibilityView="Raw"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       MaxLines="1" />

            <Image x:Name="ThumbnailImage"
                   AutomationProperties.AccessibilityView="Raw"
                   Grid.Column="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   Visibility="Collapsed" />

            <Border x:Name="SelectionBadge"
                    Grid.Column="3"
                    MinWidth="18"
                    Height="18"
                    Margin="8,0,0,0"
                    Padding="5,0,5,0"
                    CornerRadius="9"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="Collapsed">
                <TextBlock x:Name="SelectionBadgeText"
                           AutomationProperties.AccessibilityView="Raw"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>

            <Border x:Name="ShortcutKeycap"
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Padding="5,1,5,2"
                    CornerRadius="3"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    Visibility="Collapsed">
                <TextBlock x:Name="ShortcutText"
                           AutomationProperties.AccessibilityView="Raw"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <!-- Source of the accent text brush used for HighlightMatch.Color (follows the theme). -->
        <TextBlock x:Name="AccentProbe"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Grid>
</UserControl>
