<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kleio.StorageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kleio"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}" />
        <Style TargetType="NumberBox" BasedOn="{StaticResource SettingsNumberBoxStyle}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Storage_Header" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">

                <!-- ===== Save ===== -->
                <TextBlock x:Uid="Storage_SaveSection" Style="{StaticResource SettingsSectionHeaderTextStyle}" Margin="1,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Uid="Storage_SaveDescription" Style="{StaticResource SettingsParagraphTextStyle}" />
                <local:SettingsCard x:Uid="Storage_FilesCard" Glyph="&#xE8B7;">
                    <ToggleSwitch x:Name="SaveFilesToggle" x:Uid="Storage_FilesToggle" Toggled="SaveFilesToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Storage_ImagesCard" Glyph="&#xEB9F;">
                    <ToggleSwitch x:Name="SaveImagesToggle" x:Uid="Storage_ImagesToggle" Toggled="SaveImagesToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Storage_TextCard" Glyph="&#xE8A5;">
                    <ToggleSwitch x:Name="SaveTextToggle" x:Uid="Storage_TextToggle" Toggled="SaveTextToggle_Toggled" />
                </local:SettingsCard>

                <!-- ===== History ===== -->
                <TextBlock x:Uid="Storage_HistorySection" Style="{StaticResource SettingsSectionHeaderTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <local:SettingsCard x:Uid="Storage_SizeCard" Glyph="&#xE81C;">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock
                            x:Name="DatabaseSizeText"
                            x:Uid="Storage_DatabaseSize"
                            VerticalAlignment="Center"
                            Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <NumberBox
                            x:Name="HistorySizeBox"
                            x:Uid="Storage_HistorySize"
                            Minimum="1"
                            Maximum="999"
                            SmallChange="1"
                            LargeChange="10"
                            ValueChanged="HistorySizeBox_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Storage_SortByCard" Glyph="&#xE8CB;">
                    <ComboBox x:Name="SortByCombo" x:Uid="Storage_SortByCombo" SelectionChanged="SortByCombo_SelectionChanged">
                        <ComboBoxItem x:Uid="Storage_SortLastCopied" />
                        <ComboBoxItem x:Uid="Storage_SortFirstCopied" />
                        <ComboBoxItem x:Uid="Storage_SortCopies" />
                    </ComboBox>
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
